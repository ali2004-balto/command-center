# All values below are fake. Copy to .env.local for live mode.
# Bridge web app URL (from Apps Script "Deploy"). Leave empty for demo (mock) mode.
BRIDGE_URL=https://script.google.com/macros/s/EXAMPLE/exec
# Shared secret that signs Bridge requests (from showSecrets()).
BRIDGE_SECRET=0000000000000000000000000000example
# Key in the private TV link: /tv?k=<TV_KEY>
TV_KEY=1111111111111111111111111111example
# Random string that signs sign-in sessions.
AUTH_SECRET=2222222222222222222222222222example
# Google OAuth client for sign-in.
AUTH_GOOGLE_ID=example.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=example-secret
# Only this Google Workspace domain may sign in.
ALLOWED_DOMAIN=example.com
# Comma-separated owner email addresses.
OWNER_EMAILS=owner@example.com
# Optional: time zone for display (default America/Toronto).
APP_TIMEZONE=America/Toronto
# Optional: "live" or "mock". Mock = demo data, no Bridge.
BRIDGE_MODE=mock
